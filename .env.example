# --- PostgreSQL (stack aislado) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reservas_core
POSTGRES_PORT=5435

# --- Seguridad JWT ---
JWT_SECRET=cambia_este_secreto_en_produccion_por_uno_robusto_de_64_caracteres
JWT_EXPIRES_IN=1h

# --- Puertos expuestos en el host ---
BACKEND_PORT=3002
FRONTEND_PORT=8080

# --- Orígenes permitidos por CORS (separados por coma) ---
CLIENT_ORIGIN=http://localhost:8080,http://localhost:5173
